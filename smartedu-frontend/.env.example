# ═════════════════════════════════════════════════════════════════════════════════
# SmartEdu Frontend — Environment Variables
# ═════════════════════════════════════════════════════════════════════════════════
#
# INSTRUCTIONS:
# 1. Copy this file to .env in the same directory
# 2. Replace the API_URL with your backend endpoint
# 3. NEVER commit this .env file to version control
#
# ═════════════════════════════════════════════════════════════════════════════════

# ─── API URL ───────────────────────────────────────────────────────────────────
# VITE_API_URL: The base URL of your SmartEdu backend API
#
# For LOCAL development (backend running on localhost:5000):
#   VITE_API_URL=http://localhost:5000/api
#
# For LOCAL development (backend running on localhost:9999):
#   VITE_API_URL=http://localhost:9999/api
#
# For PRODUCTION (backend deployed on Render):
#   VITE_API_URL=https://YOUR-RENDER-APP.onrender.com/api
#   Example: https://smartedu-backend.onrender.com/api
#
# After getting your Render backend URL, update this value and redeploy to Vercel

VITE_API_URL=

# ═════════════════════════════════════════════════════════════════════════════════
# DEPLOYMENT CHECKLIST:
#
# Before deploying to Vercel:
# ✓ Update VITE_API_URL with your Render backend URL
# ✓ Test the API connection in your local environment first
# ✓ Push changes to GitHub (the .env file should NOT be committed)
# ✓ Vercel will automatically use the production .env values
# ✓ Do NOT put real URLs in .env.example
#
# ═════════════════════════════════════════════════════════════════════════════════
