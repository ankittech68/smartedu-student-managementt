# ═════════════════════════════════════════════════════════════════════════════════
# SmartEdu Backend — Environment Variables
# ═════════════════════════════════════════════════════════════════════════════════
# 
# INSTRUCTIONS:
# 1. Copy this file to .env in the same directory
# 2. Replace all empty values with your actual configuration
# 3. NEVER commit the .env file to version control
# 4. For production, use strong, randomly generated secrets
# 
# ═════════════════════════════════════════════════════════════════════════════════

# ─── SERVER CONFIGURATION ─────────────────────────────────────────────────────────
# PORT: Leave empty for Render (it sets PORT automatically)
#       Use 5000 for local development
# NODE_ENV: Set to 'production' on Render, 'development' locally
PORT=5000
NODE_ENV=development

# ─── DATABASE (MySQL) ─────────────────────────────────────────────────────────────
# For LOCAL DEVELOPMENT:
#   DB_HOST=localhost
#   DB_PORT=3306
#   DB_USER=root (or your MySQL user)
#   DB_PASSWORD=(your MySQL password)
#   DB_NAME=smartedu
#
# For PRODUCTION on Render:
#   Use a managed MySQL service (PlanetScale, Railway, Aiven, AWS RDS, DigitalOcean)
#   Copy connection details from your provider's dashboard
#
# IMPORTANT: Database credentials are sensitive — never share or expose these!

DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=smartedu

# ─── JWT AUTHENTICATION ───────────────────────────────────────────────────────────
# JWT_SECRET: Generate a strong random secret
#   On macOS/Linux/WSL:
#     node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#   Keep this secret — do NOT share it or commit it to version control
#   If compromised, immediately regenerate and update all sessions
#
# JWT_EXPIRES_IN: Token expiration time
#   Examples: '24h', '7d', '30 days', '86400s' (86400 seconds = 24 hours)

JWT_SECRET=
JWT_EXPIRES_IN=24h

# ─── CORS (Cross-Origin Resource Sharing) ─────────────────────────────────────────
# FRONTEND_URL: Your React frontend URL
#   For LOCAL development:  http://localhost:5173
#   For PRODUCTION on Vercel: https://YOUR-PROJECT.vercel.app
#
# The backend uses this to allow API requests from your frontend
# Other origins (Render health checks, etc.) are allowed by default

FRONTEND_URL=

# ═════════════════════════════════════════════════════════════════════════════════
# DEPLOYMENT CHECKLIST:
# 
# Before deploying to Render:
# ✓ Generate a strong JWT_SECRET
# ✓ Set NODE_ENV=production
# ✓ Set up a managed MySQL database (obtain host, port, user, password from provider)
# ✓ Set FRONTEND_URL to your Vercel production URL
# ✓ Test the /api/health endpoint to verify connectivity
# ✓ Do NOT commit this .env file to GitHub
# 
# ═════════════════════════════════════════════════════════════════════════════════
