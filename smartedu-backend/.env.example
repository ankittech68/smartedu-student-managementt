# SmartEdu Backend — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit your .env file to version control.

# ─── Server ───────────────────────────────────────────────────────────────────
# Render will set PORT automatically — leave blank here or set to 5000 for local dev
PORT=5000
NODE_ENV=production

# ─── Database (MySQL) ─────────────────────────────────────────────────────────
# Obtain these from your hosted MySQL provider (PlanetScale, Railway, Aiven, etc.)
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=smartedu

# ─── Authentication ───────────────────────────────────────────────────────────
# Generate a strong random secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=24h

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Your Vercel frontend URL (e.g. https://smartedu.vercel.app)
FRONTEND_URL=
